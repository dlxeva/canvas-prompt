{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canvas-prompt.local/schemas/artifact-review-package-v0.2.schema.json",
  "title": "Artifact Review Prompt Package v0.2 Draft",
  "description": "Page-level, evidence-bound review context for local read-only artifacts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "artifact",
    "pages",
    "annotations",
    "evidence",
    "privacy",
    "review_state"
  ],
  "properties": {
    "schema_version": { "const": "artifact-review/0.2-draft" },
    "package_id": { "type": "string", "pattern": "^arp_[A-Za-z0-9_-]+$" },
    "created_at": { "type": "string", "format": "date-time" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "artifact_kind", "source_version_id", "source_sha256", "page_count", "read_only"],
      "properties": {
        "artifact_id": { "type": "string", "pattern": "^art_[A-Za-z0-9_-]+$" },
        "artifact_kind": { "enum": ["pdf", "pptx"] },
        "source_version_id": { "type": "string" },
        "source_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "parent_artifact_id": { "type": "string" },
        "page_count": { "type": "integer", "minimum": 1 },
        "read_only": { "const": true },
        "render_derivative": {
          "description": "Optional local rendering derivative. The original artifact_kind/source_sha256 remain authoritative.",
          "type": "object",
          "additionalProperties": false,
          "required": ["artifact_kind", "source_sha256", "page_count", "renderer"],
          "properties": {
            "artifact_kind": { "const": "pdf_derivative" },
            "source_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "page_count": { "type": "integer", "minimum": 1 },
            "renderer": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "version": { "type": "string" }
              }
            }
          }
        },
        "source_locator": {
          "description": "Private-local reference only. Exports must omit this field.",
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": { "required": ["render_derivative"] },
          "then": { "properties": { "artifact_kind": { "const": "pptx" } } }
        }
      ]
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["page_id", "page_number", "render_box", "rotation_degrees"],
        "properties": {
          "page_id": { "type": "string", "pattern": "^page_[A-Za-z0-9_-]+$" },
          "page_number": { "type": "integer", "minimum": 1 },
          "page_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "render_box": {
            "type": "object",
            "additionalProperties": false,
            "required": ["width", "height", "unit"],
            "properties": {
              "width": { "type": "number", "exclusiveMinimum": 0 },
              "height": { "type": "number", "exclusiveMinimum": 0 },
              "unit": { "enum": ["pdf_point", "pixel"] }
            }
          },
          "rotation_degrees": { "enum": [0, 90, 180, 270] }
        }
      }
    },
    "page_visits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["page_number", "at_ms"],
        "properties": {
          "page_number": { "type": "integer", "minimum": 1 },
          "at_ms": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "annotations": {
      "type": "array",
      "items": { "$ref": "#/$defs/annotation" }
    },
    "evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence" }
    },
    "voice_segments": {
      "description": "Local transcript evidence only. Source audio bytes are never exported.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["segment_id", "start_ms", "end_ms", "text"],
        "properties": {
          "segment_id": { "type": "string", "pattern": "^voice_[A-Za-z0-9_-]+$" },
          "start_ms": { "type": "integer", "minimum": 0 },
          "end_ms": { "type": "integer", "minimum": 0 },
          "text": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "reference_resolutions": {
      "description": "Deterministic D-087 evidence resolution. unique_evidence is not a user confirmation or edit authorization.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["resolution_id", "voice_segment_id", "page_number", "status", "evidence_ids"],
        "allOf": [
          {
            "if": { "properties": { "status": { "const": "unique_evidence" } } },
            "then": { "required": ["annotation_id"] }
          },
          {
            "if": { "properties": { "status": { "const": "clarification_required" } } },
            "then": { "not": { "required": ["annotation_id"] } }
          }
        ],
        "properties": {
          "resolution_id": { "type": "string", "pattern": "^ref_[A-Za-z0-9_-]+$" },
          "voice_segment_id": { "type": "string", "pattern": "^voice_[A-Za-z0-9_-]+$" },
          "page_number": { "type": "integer", "minimum": 1 },
          "status": { "enum": ["unique_evidence", "clarification_required"] },
          "annotation_id": { "type": "string", "pattern": "^ann_[A-Za-z0-9_-]+$" },
          "evidence_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^ev_[A-Za-z0-9_-]+$" } }
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["processing", "source_bytes_in_export", "retention"],
      "properties": {
        "processing": { "const": "local_only" },
        "source_bytes_in_export": { "const": false },
        "retention": { "enum": ["session_only", "private_local_until_deleted"] },
        "redaction_status": { "enum": ["not_reviewed", "reviewed", "redacted"] }
      }
    },
    "review_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interpretation_status", "execution_authorized"],
      "properties": {
        "interpretation_status": { "enum": ["evidence_only", "clarification_required", "user_confirmed"] },
        "execution_authorized": { "const": false },
        "proposal_id": { "type": "string" }
      }
    }
  },
  "$defs": {
    "normalized_region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coordinate_space", "x_ratio", "y_ratio", "width_ratio", "height_ratio"],
      "properties": {
        "coordinate_space": { "const": "page_normalized_v1" },
        "x_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
        "y_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
        "width_ratio": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "height_ratio": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      }
    },
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["annotation_id", "page_id", "kind", "region", "created_at_ms", "binding_status"],
      "properties": {
        "annotation_id": { "type": "string", "pattern": "^ann_[A-Za-z0-9_-]+$" },
        "page_id": { "type": "string", "pattern": "^page_[A-Za-z0-9_-]+$" },
        "kind": { "enum": ["circle", "arrow", "ink", "pointer_anchor"] },
        "region": { "$ref": "#/$defs/normalized_region" },
        "gesture_points": {
          "description": "Raw manual trajectory in page_normalized_v1. It is required for faithful replay of ink and may also preserve circle or arrow endpoints.",
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["x_ratio", "y_ratio"],
            "properties": {
              "x_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
              "y_ratio": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        },
        "created_at_ms": { "type": "integer", "minimum": 0 },
        "voice_window": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start_ms", "end_ms"],
          "properties": {
            "start_ms": { "type": "integer", "minimum": 0 },
            "end_ms": { "type": "integer", "minimum": 0 },
            "transcript_segment_ids": { "type": "array", "items": { "type": "string" } }
          }
        },
        "evidence_ids": { "type": "array", "items": { "type": "string" } },
        "binding_status": { "enum": ["confirmed", "candidate", "clarification_required"] }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "kind", "assertion_level"],
      "properties": {
        "evidence_id": { "type": "string", "pattern": "^ev_[A-Za-z0-9_-]+$" },
        "kind": { "enum": ["page_region", "annotation", "voice_segment", "user_assertion", "clarification_response"] },
        "page_id": { "type": "string" },
        "annotation_id": { "type": "string" },
        "assertion_level": { "enum": ["raw", "observation", "explicit_user_assertion"] },
        "time_window_ms": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start_ms", "end_ms"],
          "properties": {
            "start_ms": { "type": "integer", "minimum": 0 },
            "end_ms": { "type": "integer", "minimum": 0 }
          }
        }
      }
    }
  }
}
